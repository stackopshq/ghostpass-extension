{
  "name": "@ghostpass/extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Extension navigateur GhostPass (Manifest V3) — coffre zero-knowledge, autofill",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "vite build && node scripts/build-firefox.mjs",
    "build:dev": "vite build --mode development",
    "build:safari": "bash scripts/build-safari.sh",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package-chrome.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir=dist-firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@stackops/ghostpass-crypto-wasm": "^0.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.0",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/chrome": "*",
    "svelte": "^5.15.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
